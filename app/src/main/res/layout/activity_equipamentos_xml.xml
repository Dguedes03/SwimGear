<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootXmlList"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:padding="20dp">
    <Button android:id="@+id/buttonVoltar" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:minHeight="48dp" android:text="@string/voltar"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/app_name" android:textSize="32sp" android:textStyle="bold" android:layout_marginTop="12dp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/xml_subtitle" android:textSize="12sp" android:textColor="@color/teal" android:layout_marginTop="6dp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/xml_notice" android:textSize="14sp" android:padding="14dp"
        android:background="@drawable/bg_mint" android:layout_marginVertical="16dp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/xml_title" android:textSize="22sp" android:textStyle="bold" android:layout_marginBottom="12dp"/>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerEquipamentos"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:clipToPadding="false" android:paddingBottom="12dp"/>
</LinearLayout>
