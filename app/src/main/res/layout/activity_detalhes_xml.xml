<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootXmlDetail"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:padding="20dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <Button android:id="@+id/buttonVoltar" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/voltar"/>
        <ImageView android:id="@+id/imageEquipamento" android:layout_width="112dp" android:layout_height="112dp"
            android:layout_gravity="center_horizontal" android:layout_marginTop="28dp" android:padding="24dp"
            android:background="@drawable/bg_mint" android:importantForAccessibility="no"/>
        <TextView android:id="@+id/textCategoria" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center" android:textSize="14sp" android:textColor="@color/teal" android:layout_marginTop="20dp"/>
        <TextView android:id="@+id/textNome" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center" android:textSize="30sp" android:textStyle="bold" android:layout_marginTop="12dp"/>
        <TextView android:id="@+id/textMarca" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center" android:textSize="18sp" android:layout_marginTop="12dp"/>
        <TextView android:id="@+id/textStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center" android:textSize="18sp" android:padding="20dp"
            android:background="@drawable/bg_mint" android:layout_marginVertical="24dp" android:accessibilityLiveRegion="polite"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/observacoes" android:textSize="18sp" android:textStyle="bold"/>
        <TextView android:id="@+id/textDescricao" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="16sp" android:layout_marginTop="10dp"/>
        <Button android:id="@+id/buttonPronto" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="56dp" android:layout_marginTop="28dp"/>
    </LinearLayout>
</ScrollView>
